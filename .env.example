# ─────────────────────────────────────────────────────────────
#  Deriv Over/Under Dual Bot — Environment Variables
#  Copy this file to .env for local testing (never commit .env)
#  On Railway: paste these into the "Variables" tab instead
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
DERIV_API_TOKEN=YOUR_API_TOKEN_HERE

# ── Market (used as fallback if scanner is disabled) ─────────
MARKET=R_100

# ── Stake & Risk ─────────────────────────────────────────────
BASE_STAKE=1.00
DURATION=1
RISE_THRESHOLD=0.3
TARGET_PROFIT=50.00
STOP_LOSS=20.00

# ── Martingale ───────────────────────────────────────────────
MART_ENABLED=true
MART_MULTIPLIER=6.0

# ── Bot toggles ──────────────────────────────────────────────
OVER_ENABLED=true
UNDER_ENABLED=true

# ── Advanced ─────────────────────────────────────────────────
HIST_LEN=500

# ── Market Scanner ───────────────────────────────────────────
# Scans all configured markets, ranks by digit-frequency spread
# (max% − min%), and auto-switches to the most stable one.
SCAN_ENABLED=true

# Comma-separated list of markets to scan (default: all 10)
# Valid values: R_10 R_25 R_50 R_75 R_100 1HZ10V 1HZ25V 1HZ50V 1HZ75V 1HZ100V
#SCAN_MARKETS=R_10,R_25,R_50,R_75,R_100,1HZ10V,1HZ25V,1HZ50V,1HZ75V,1HZ100V

# Number of historical ticks to fetch per market for the scan
SCAN_TICK_COUNT=1000

# A market is "stable" when its spread (max% − min%) is at or
# below this value. Lower = stricter. Raise if no market qualifies.
SCAN_THRESHOLD=4.0

# Seconds between automatic re-scans (300 = every 5 minutes)
AUTO_SCAN_INTERVAL=300

# Run a scan immediately on startup before activating the bots
SCAN_ON_STARTUP=true

# ── Deriv App ID (leave default unless you registered your own)
# DERIV_APP_ID=1089
