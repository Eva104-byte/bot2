# ─────────────────────────────────────────────────────────────
#  Deriv Over/Under Dual Bot — Environment Variables
#  Copy this file to .env for local testing (never commit .env)
#  On Railway: paste these into the "Variables" tab instead
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────
DERIV_API_TOKEN=YOUR_API_TOKEN_HERE

# ── Market ───────────────────────────────────────────────────
# Options: R_10, R_25, R_50, R_75, R_100,
#          1HZ10V, 1HZ25V, 1HZ50V, 1HZ75V, 1HZ100V
MARKET=R_100

# ── Stake & Risk ─────────────────────────────────────────────
BASE_STAKE=1.00
DURATION=1
RISE_THRESHOLD=0.3
TARGET_PROFIT=50.00
STOP_LOSS=20.00

# ── Martingale ───────────────────────────────────────────────
MART_ENABLED=true
MART_MULTIPLIER=4.5

# ── Bot toggles ──────────────────────────────────────────────
OVER_ENABLED=true
UNDER_ENABLED=true

# ── Advanced ─────────────────────────────────────────────────
HIST_LEN=500

# ── Deriv App ID (leave default unless you registered your own)
# DERIV_APP_ID=1089
